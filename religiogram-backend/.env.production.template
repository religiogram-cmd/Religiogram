# ═══════════════════════════════════════════════════════════════════════════════
#  ReligioGram — Production / Test-deploy env template
#
#  1.  Copy to .env.production (or set these as your hosting platform's
#      env vars: Railway / Render / Fly.io / Vercel / AWS).
#  2.  Replace every <FILL_…> placeholder with the real secret.
#  3.  Never commit the populated file. .gitignore already covers .env*.
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_URL=https://api.religiogram.app
WEB_APP_URL=https://religiogram.app

# ── Database (Postgres 16 with PostGIS) ────────────────────────────────────────
# DATABASE_URL points your app through PgBouncer (recommended for prod).
# DATABASE_DIRECT_URL bypasses PgBouncer — needed for migrations + advisory locks.
DATABASE_URL=postgresql://<USER>:<PASS>@<HOST>:5432/<DB>?sslmode=require
DATABASE_DIRECT_URL=postgresql://<USER>:<PASS>@<HOST>:5432/<DB>?sslmode=require
DATABASE_VIA_PROXY=false

# ── Redis (sessions, queues, rate-limit, cache) ────────────────────────────────
REDIS_URL=rediss://default:<PASS>@<HOST>:6379
REDIS_CACHE_URL=rediss://default:<PASS>@<HOST>:6379
REDIS_CACHE_TLS=true

# ── JWT (RS256 — generate with `openssl genrsa -out private.pem 2048`) ─────────
# Replace literal newlines with \n. Public key derived from private:
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=<FILL_PRIVATE_PEM_WITH_LITERAL_\n>
JWT_PUBLIC_KEY=<FILL_PUBLIC_PEM_WITH_LITERAL_\n>
JWT_REFRESH_SECRET=<FILL_64_CHAR_HEX_RANDOM>
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── OTP (SMS) ──────────────────────────────────────────────────────────────────
# We use the same vendor we wire SMS through (Twilio or MSG91)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=<FILL>
MSG91_SENDER_ID=RELIGI

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<FILL>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<FILL>
GOOGLE_OAUTH_CALLBACK_URL=https://api.religiogram.app/api/v1/auth/google/callback

# ── Razorpay (payments + Razorpay Checkout SDK) ────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_<FILL>
RAZORPAY_KEY_SECRET=<FILL>
RAZORPAY_WEBHOOK_SECRET=<FILL>

# ── Object storage (S3 or Cloudflare R2) ──────────────────────────────────────
# For R2: set STORAGE_R2_ENDPOINT. For AWS S3: leave it blank.
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=religiogram-prod
STORAGE_ACCESS_KEY_ID=<FILL>
STORAGE_SECRET_ACCESS_KEY=<FILL>
STORAGE_R2_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=https://media.religiogram.app

# ── Email (SES / Resend / Postmark) ────────────────────────────────────────────
EMAIL_PROVIDER=ses
EMAIL_FROM=hello@religiogram.app
EMAIL_REPLY_TO=support@religiogram.app
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=<FILL>
AWS_SES_SECRET_ACCESS_KEY=<FILL>

# ── Google Places (used by /v1/places/search/google) ───────────────────────────
GOOGLE_PLACES_API_KEY=<FILL>

# ── Gemini (RG AI chat + horoscope) ────────────────────────────────────────────
GEMINI_API_KEY=<FILL>
GEMINI_MODEL=gemini-1.5-flash

# ── Sentry (error tracking + perf) ─────────────────────────────────────────────
SENTRY_DSN=<FILL>
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── coturn (WebRTC TURN for live consultations) ────────────────────────────────
# Production should use a managed TURN; for the test deploy you can stand up
# coturn on the same host and point this at it.
TURN_HOST=turn.religiogram.app
TURN_PORT=3478
TURN_SHARED_SECRET=<FILL>

# ── CORS (comma-separated origins). Empty in prod = startup failure. ───────────
CORS_ORIGINS=https://religiogram.app,https://www.religiogram.app
