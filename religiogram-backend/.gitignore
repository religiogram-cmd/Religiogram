dist/
build/
out/
.next/
.turbo/
coverage/
.nyc_output/
tsconfig.tsbuildinfo
*.tsbuildinfo

# ─── Tests / tooling ─────────────────────────────────────────────────────────
playwright-report/
test-results/
.husky/_/

