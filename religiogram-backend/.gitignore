# ─── Secrets — NEVER commit these ───────────────────────────────────────────
# Block every .env* variant. Only the template + example are allowed.
.env
.env.*
!.env.example
!.env.production.template
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
jwt-private.key
jwt-public.key
secrets/

# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

