{
    "name": "religiogram-api",
    "version": "0.1.0",
    "description": "ReligioGram backend â€” OTP + Google OAuth, NestJS, PostgreSQL, Redis",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main.js",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest",
        "test:cov": "jest --coverage",
        "test:cov:gate": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":60,\"functions\":60,\"branches\":50}}'",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "npm run typeorm -- migration:generate -d src/config/datasource.ts",
        "migration:run": "npm run typeorm -- migration:run -d src/config/datasource.ts",
        "migration:revert": "npm run typeorm -- migration:revert -d src/config/datasource.ts",
        "seed": "ts-node src/seed.ts",
        "typecheck": "tsc --noEmit",
        "verify": "npm run typecheck && npm run lint && npm test -- --passWithNoTests --forceExit",
        "guard:check": "bash ../scripts/check-admin-guards.sh",
        "scan:secrets": "gitleaks detect --source=. --no-git --config=../.gitleaks.toml",
        "scan:vulns": "npm audit --audit-level=high",
        "preversion": "npm run verify",
        "prepack": "npm run verify",
        "prepare": "husky install || true",
        "test:e2e:pw": "playwright test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.658.0",
        "@aws-sdk/client-sns": "^3.658.0",
        "@aws-sdk/s3-request-presigner": "^3.658.0",
        "@google/generative-ai": "^0.21.0",
        "@growthbook/growthbook": "^1.3.0",
        "@nest-lab/throttler-storage-redis": "^1.1.0",
        "@nestjs/axios": "^3.0.2",
        "@nestjs/bullmq": "^10.2.1",
        "@nestjs/common": "^10.3.10",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.3.10",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.3.10",
        "@nestjs/platform-socket.io": "^10.3.10",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^7.4.0",
        "@nestjs/throttler": "^6.1.1",
        "@nestjs/typeorm": "^10.0.2",
        "@nestjs/websockets": "^10.3.10",
        "@opensearch-project/opensearch": "^3.6.0",
        "@opentelemetry/auto-instrumentations-node": "^0.49.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
        "@opentelemetry/resources": "^1.25.0",
        "@opentelemetry/sdk-node": "^0.52.0",
        "@opentelemetry/sdk-trace-base": "^1.25.0",
        "@opentelemetry/semantic-conventions": "^1.25.0",
        "@sentry/nestjs": "^8.0.0",
        "@socket.io/redis-adapter": "^8.3.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/uuid": "^10.0.0",
        "axios": "^1.7.2",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.12.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.7",
        "express": "^4.19.2",
        "file-type": "16.5.4",
        "firebase-admin": "^12.3.0",
        "helmet": "^7.1.0",
        "ioredis": "^5.4.1",
        "kafkajs": "^2.2.4",
        "nestjs-pino": "^4.1.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.12.0",
        "pino-http": "^10.3.0",
        "pino-pretty": "^13.0.0",
        "prom-client": "^15.1.3",
        "razorpay": "^2.9.2",
        "redis": "^5.0.0",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.12.3",
        "rxjs": "^7.8.1",
        "sharp": "^0.33.4",
        "socket.io": "^4.7.5",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.20",
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.2",
        "@nestjs/schematics": "^10.1.2",
        "@nestjs/testing": "^10.3.10",
        "@playwright/test": "^1.44.0",
        "@types/compression": "^1.7.5",
        "@types/cookie-parser": "^1.4.7",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.10",
        "@types/passport-google-oauth20": "^2.0.16",
        "@types/passport-jwt": "^4.0.1",
        "@types/pino-http": "^5.8.4",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.7.0",
        "prettier": "^3.3.2",
        "supertest": "^7.0.0",
        "testcontainers": "^10.10.3",
        "ts-jest": "^29.1.5",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.3"
    },
    "engines": {
        "node": "20.x"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "src/**/*.(t|j)s",
            "!src/**/*.migration.ts",
            "!src/migrations/**",
            "!src/**/*.entity.ts",
            "!src/main.ts"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "coverageThreshold": {
            "global": {
                "lines": 60,
                "functions": 60,
                "branches": 50
            }
        }
    }
}
