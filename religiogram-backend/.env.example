# ───────────────────────────────────────────────────────────────
#  ReligioGram API — Environment Variables
#  In production: load secrets from AWS Secrets Manager / SSM
#  Never commit a real .env file
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_NAME=religiogram-api
CORS_ORIGINS=http://localhost:3000,https://app.religiogram.com,religiogram://

# ── PostgreSQL (RDS Mumbai in production) ───────────────────────
DATABASE_URL=postgresql://app:password@localhost:5432/religiogram
# Direct URL bypasses PgBouncer — used for migrations (advisory locks need session mode).
# In production set to the RDS endpoint directly (not the PgBouncer host).
# If not set, migrations fall back to DATABASE_URL (fine when not using PgBouncer).
DATABASE_DIRECT_URL=postgresql://app:password@localhost:5432/religiogram
DATABASE_POOL_SIZE=20
DATABASE_SSL=false                # true in production
DATABASE_VIA_PROXY=false          # true when routing through PgBouncer

# ── Redis — queue / throttle / sessions (noeviction) ────────────
# BullMQ jobs, rate-limit counters, session keys.
# Configured with maxmemory-policy noeviction so job data is NEVER
# silently evicted; Redis returns an error on writes when full instead.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false                   # true in production
REDIS_KEY_PREFIX=rg:

# ── Redis Cache (allkeys-lru) ─────────────────────────────────────
# Dedicated Redis for HTTP response caching (CacheService).
# Configured with maxmemory-policy allkeys-lru: safe to evict since
# all cache entries are re-fetchable from the DB on a miss.
# Falls back to REDIS_HOST/REDIS_PORT when not set (local dev).
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6380             # 6380 in docker-compose (redis-cache)
REDIS_CACHE_PASSWORD=
REDIS_CACHE_TLS=false

