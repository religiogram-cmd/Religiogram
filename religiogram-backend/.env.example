JWT_ISSUER=https://auth.religiogram.com
JWT_AUDIENCE=religiogram-api
JWT_ACCESS_TTL=900                # 15 minutes
JWT_REFRESH_TTL=604800            # 7 days

# ── OTP ─────────────────────────────────────────────────────────
# HMAC key — generate with: node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"hex\"))"
# P0-4 (v4): dedicated refresh-token HMAC secret. MUST differ from OTP_SECRET.
REFRESH_TOKEN_HMAC_SECRET=21fc26f1ad08672dafb18d188ed6a483d28266b05af8c25277fedd68b446224b3661d73a40d75059eaf53e19cf64764b
OTP_SECRET=d9f05754852ef6173cfc46a36da8c594d6e256adda24e65ff7d23c62cd77a63f7a379bb97610a3411b99e1803e2f3072
OTP_LENGTH=6
OTP_TTL=300                       # seconds (5 min)
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30            # seconds

# ── Rate limits ─────────────────────────────────────────────────
RL_SEND_OTP_PHONE=3               # per 5 min
RL_SEND_OTP_IP=10                 # per hour
RL_GLOBAL_PER_MIN=100             # per IP per minute (global)

# ── SMS provider ────────────────────────────────────────────────
SMS_PROVIDER=msg91                # msg91 | sns
MSG91_AUTH_KEY=replace-me
MSG91_SENDER_ID=RELGRM
MSG91_TEMPLATE_ID=replace-me

# ── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_APP_REDIRECT_SCHEME=religiogram://auth

# ── AWS Cognito (optional — for OIDC federation) ────────────────
COGNITO_USER_POOL_ID=ap-south-1_xxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxx
COGNITO_REGION=ap-south-1

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Firebase Admin (base64-encoded service account JSON) ─────
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then base64 encode: base64 -i serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# ── Socket.io / WebSockets ────────────────────────────────────
# No extra env needed — uses the same REDIS_* vars above.
# WS path is /socket.io (default), namespace /consultation

# ── Push Notification Queue ───────────────────────────────────
PUSH_PROCESSOR_CONCURRENCY=5

# ── FCM (explicit fields — alternative to FIREBASE_SERVICE_ACCOUNT) ──
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
FCM_CLIENT_EMAIL=

# ── AWS S3 / CDN ──────────────────────────────────────────────
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=religiogram-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=https://cdn.religiogram.in
CDN_DISTRIBUTION_ID=              # CloudFront distribution ID (for cache invalidation)

# ── Image thumbnail pipeline (Lambda resize) ──────────────────
# Lambda is deployed via deploy/thumbnail-function/ (SAM template).
# Set THUMBNAIL_ENABLED=false in local dev — thumbnails fall back to
# the original image URL when the Lambda is not deployed.
# THUMBNAIL_FUNCTION_ARN is informational only (the API doesn't invoke
# the Lambda directly — it is triggered by S3 events).
THUMBNAIL_ENABLED=false               # true in production
THUMBNAIL_FUNCTION_ARN=               # arn:aws:lambda:ap-south-1:…:function:religiogram-thumbnails

# ── Google Places API ─────────────────────────────────────────
# P2-9: Restrict this key in Google Cloud Console to HTTP referrers matching
# your production domain (e.g. https://religiogram.app/*) so it cannot be
# abused if it leaks in network traffic. Go to:
#   https://console.cloud.google.com → Credentials → your key → Application restrictions → HTTP referrers
# Also enable only the APIs this key needs: Places API, Maps JavaScript API.
GOOGLE_PLACES_API_KEY=

# ── k6 / dev OTP bypass ───────────────────────────────────────
# P3: Set DEV_OTP_BYPASS=1 in load-test / local dev environments to allow
# OTP '000000' to pass without Redis lookup. NEVER set to 1 in production.
# The backend enforces NODE_ENV !== 'production' as an additional guard.
DEV_OTP_BYPASS=

# ── Swagger UI basic auth (staging only) ─────────────────────
# P3: Set both vars in staging to password-protect /api/docs.
# Leave blank in local dev (unprotected) or production (Swagger is disabled).
SWAGGER_USER=
SWAGGER_PASS=

# ── Sentry ────────────────────────────────────────────────────
# Leave blank to disable error tracking (e.g. local dev)
SENTRY_DSN=https://replace-me@o0.ingest.sentry.io/0

# ── GrowthBook OSS Feature Flags ──────────────────────────────
# Leave GROWTHBOOK_CLIENT_KEY blank to use Redis/env flags only
GROWTHBOOK_CLIENT_KEY=sdk-replace-me
GROWTHBOOK_API_HOST=https://cdn.growthbook.io

# ── Per-flag env fallbacks (used when GrowthBook + Redis both miss) ──
FF_ENABLE_CHAT=true
FF_ENABLE_BOOKING=true
FF_ENABLE_CONSULTATION=true
FF_ENABLE_DONATIONS=true
FF_ENABLE_WALLET_TOPUP=true
# Defer feed fan-out to BullMQ for authors with > FEED_ASYNC_FANOUT_THRESHOLD friends.
# Keep false until > 10k active users with high-follower authors.
FF_ENABLE_ASYNC_FANOUT=false
FEED_ASYNC_FANOUT_THRESHOLD=500

# ── OpenTelemetry ─────────────────────────────────────────────
# OTLP/HTTP collector endpoint — Jaeger all-in-one listens on 4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=religiogram-api
# Set to 'true' to disable all OTel instrumentation (e.g. in unit tests)
OTEL_DISABLED=false

# ── Redis Sentinel / HA ────────────────────────────────────────
# Leave blank to use standalone REDIS_HOST/REDIS_PORT above.
# Format: "host1:26379,host2:26379,host3:26379"
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=mymaster
REDIS_SENTINEL_PASSWORD=

# ── Redis Cluster (50GB+ dataset, 1M+ active users) ────────────
# Leave blank to stay in standalone / Sentinel mode (default).
# Enable when the Redis keyspace grows beyond ~50 GB — typically at
# 1M+ daily active users with active session data + throttle counters.
#
# Minimum: 3 primary + 3 replica nodes (6 total).
# Format: "host1:6379,host2:6379,...,host6:6379"
# AWS ElastiCache: use the configuration endpoint.
#
# IMPORTANT: BullMQ requires scaleReads=master in cluster mode.
# See src/redis/redis.service.ts for the cluster wiring.
REDIS_CLUSTER_NODES=            # blank = standalone/Sentinel
REDIS_CLUSTER_PASSWORD=
REDIS_CLUSTER_TLS=false
REDIS_CLUSTER_NAT_MAP=          # optional: "clusterIp1->publicIp1,..."

# ── OTP rate ceilings (plan §8) ───────────────────────────────
OTP_SMS_DAILY_CEILING=3            # max sends per phone per calendar day (UTC)
OTP_SMS_HOURLY_CEILING=5           # max sends per phone per clock hour

# ── Cost-lock hard caps (P0-5) ────────────────────────────────
# Daily AI spend ceiling in rupees. Server blocks Gemini calls once exceeded.
COST_LOCK_AI_DAILY_RUPEES=2000
# Daily OTP/SMS spend ceiling in rupees. Blocks OTP sends once exceeded.
COST_LOCK_OTP_DAILY_RUPEES=500
# Telegram bot token + chat ID for founder alerts (optional — skip to disable alerts).
# Create bot: https://t.me/BotFather  |  Get chat ID: https://t.me/userinfobot
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── Cluster mode ──────────────────────────────────────────────
# Set CLUSTER=false in Docker/K8s where replicas are managed externally.
# Defaults to true in production, false otherwise.
CLUSTER=true
WORKERS=                          # blank = os.cpus().length

# ── Graceful shutdown ─────────────────────────────────────────
SHUTDOWN_TIMEOUT_MS=15000         # max time to drain in-flight requests

# ── Resend (transactional email) ──────────────────────────────
RESEND_API_KEY=re_replace-me
EMAIL_FROM=ReligioGram <noreply@religiogram.app>

# ── CI / deployment secrets (GitHub Actions) ──────────────────
# Set in repository Settings → Secrets and variables → Actions
# SSH_HOST=                       # production server IP / hostname
# SSH_USER=deploy
# SSH_KEY=                        # base64-encoded private key
# SNYK_TOKEN=                     # Snyk API token for security scanning

# ── RG AI (Section 3, 9, 11) ──────────────────────────────────────────────────
GEMINI_API_KEY=                         # Google AI Studio key — get free at https://aistudio.google.com/app/apikey
GEMINI_MODEL_FLASH=gemini-2.5-flash     # Default fast model
GEMINI_MODEL_PRO=gemini-2.5-pro         # Deep astrology / vision
AI_FREE_DAILY_MESSAGES=20               # Free tier daily message limit (§11.1)
AI_PREMIUM_PRICE_PAISE=4900             # ₹49/month = 4900 paise
AI_RAG_SIMILARITY_THRESHOLD=0.75        # Cosine similarity min for RAG hit
SWISSEPH_PATH=/app/swisseph_files       # Path to Swiss Ephemeris .se1 data files

RAZORPAY_AI_PLAN_ID=                    # Razorpay plan ID for Rs.49/month AI Premium

# P1-6 / P3: AES-256-GCM PII encryption keys (REQUIRED in production)
# Generate with: openssl rand -hex 32
BIRTH_PROFILE_ENCRYPTION_KEY=           # 64 hex chars — encrypts AI birth profile PII
PAYOUT_ENCRYPTION_KEY=                  # 64 hex chars — encrypts provider bank account details

# TURN server for WebRTC peer connections
TURN_HOST=turn.yourdomain.com
TURN_SHARED_SECRET=your-turn-shared-secret-here

# ── Consultation Billing ──────────────────────────────────────
# How often the billing ticker fires (ms). Default: 60000 (1 min).
# Lower only in development/load tests. Never below 5000.
BILLING_TICK_INTERVAL_MS=60000

# ── Invite-a-Priest flow ────────────────────────────────────────────────────
# Well-known synthetic service-catalog UUID used for free-form invite
# bookings (CreateInviteBookingDto on POST /v1/bookings/invite).
# A migration seeds this row at startup; you can override with any UUID
# but it must already exist in the services_master table.
INVITE_CEREMONY_SERVICE_ID=00000000-0000-0000-0000-00000000beef
