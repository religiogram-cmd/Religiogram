{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "ReligioGram PostgreSQL — connection pool, slow queries, table bloat, partition row counts",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Connection Pool",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Total active connections across all states (active, idle, idle in transaction). Alert threshold: 350 (warn), 450 (critical).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 350 },
              { "color": "red",    "value": 450 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "title": "Total Connections",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(pg_active_connections_count)",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Connections in 'idle in transaction' state. Sustained non-zero values indicate missing COMMIT/ROLLBACK in application code.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 5 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "title": "Idle-in-Transaction",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pg_active_connections_count{state=\"idle in transaction\"})",
          "legendFormat": "Idle-in-txn",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Queries running longer than 5 seconds right now.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 5 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "title": "Long-Running Queries (>5s)",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_long_running_queries_count",
          "legendFormat": "Count",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Longest currently-running query in seconds.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 30 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "title": "Longest Query Duration",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_long_running_queries_max_duration_s",
          "legendFormat": "Max duration",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Connection count by state over time.",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "active" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "idle" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "idle in transaction" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "id": 5,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Connections by State",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (state) (pg_active_connections_count)",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "expr": "500",
          "legendFormat": "max_client_conn",
          "refId": "B"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Slow Queries (pg_stat_statements)",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Top-10 queries by mean execution time. Requires pg_stat_statements extension and postgres_exporter custom queries.",
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Mean (ms)" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 500 },
                    { "color": "red", "value": 2000 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "id": 10,
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Mean (ms)", "desc": true }]
      },
      "title": "Top Slow Queries — Mean Execution Time",
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "query_snippet": "Query",
              "Value #mean": "Mean (ms)",
              "Value #calls": "Calls",
              "Value #total": "Total (ms)",
              "Value #cache": "Cache Hit %"
            }
          }
        }
      ],
      "type": "table",
      "targets": [
        {
          "expr": "topk(10, pg_stat_statements_top_slow_mean_exec_time_ms)",
          "legendFormat": "{{query_snippet}}",
          "refId": "mean",
          "instant": true
        },
        {
          "expr": "topk(10, pg_stat_statements_top_slow_calls)",
          "legendFormat": "{{query_snippet}}",
          "refId": "calls",
          "instant": true
        },
        {
          "expr": "topk(10, pg_stat_statements_top_slow_cache_hit_pct)",
          "legendFormat": "{{query_snippet}}",
          "refId": "cache",
          "instant": true
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Mean execution time trends for the top slow queries. Spikes indicate regression — compare against deploy timestamps.",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "id": 11,
      "title": "Slow Query Mean Execution Time (Time Series)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(5, pg_stat_statements_top_slow_mean_exec_time_ms)",
          "legendFormat": "{{query_snippet}}",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 102,
      "title": "Table Bloat & Autovacuum",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Dead tuple ratio per table. Values above 20% indicate autovacuum is not keeping up — leads to table bloat and degraded scan performance.",
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Dead Tuple %" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 10 },
                    { "color": "red",    "value": 20 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "custom.width", "value": 110 }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "id": 20,
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Dead Tuple %", "desc": true }]
      },
      "title": "Table Bloat — Dead Tuple Ratio",
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "table_name":            "Table",
              "Value #dead_pct":       "Dead Tuple %",
              "Value #total_mb":       "Total (MB)",
              "Value #index_mb":       "Index (MB)",
              "Value #live":           "Live Tuples",
              "Value #dead":           "Dead Tuples"
            }
          }
        }
      ],
      "type": "table",
      "targets": [
        {
          "expr": "pg_table_bloat_estimate_dead_tuple_ratio_pct",
          "legendFormat": "{{table_name}}",
          "refId": "dead_pct",
          "instant": true
        },
        {
          "expr": "pg_table_bloat_estimate_total_size_mb",
          "legendFormat": "{{table_name}}",
          "refId": "total_mb",
          "instant": true
        },
        {
          "expr": "pg_table_bloat_estimate_index_size_mb",
          "legendFormat": "{{table_name}}",
          "refId": "index_mb",
          "instant": true
        },
        {
          "expr": "pg_table_bloat_estimate_n_live_tup",
          "legendFormat": "{{table_name}}",
          "refId": "live",
          "instant": true
        },
        {
          "expr": "pg_table_bloat_estimate_n_dead_tup",
          "legendFormat": "{{table_name}}",
          "refId": "dead",
          "instant": true
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 103,
      "title": "Partition Row Counts",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Estimated row counts for hot partitioned tables (feed_items, bookings, ledger_entries, notifications). Updated by ANALYZE — not real-time.",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "id": 30,
      "title": "Partition Table Row Counts (Estimated)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "pg_partition_row_counts_estimated_rows",
          "legendFormat": "{{table_name}}",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["postgres", "database", "religiogram"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ReligioGram — PostgreSQL Overview",
  "uid": "rg-postgres-overview",
  "version": 1
}
